{
  "compilerOptions": {
    "target": "ES2020",                   // เลือกการตั้งค่าที่ถูกต้อง
    "module": "ESNext",                   // เลือก ESNext สำหรับโมดูล
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable", "ESNext"],
    "skipLibCheck": true,
    "jsx": "preserve",                    // ใช้ preserve สำหรับ JSX
    "moduleResolution": "node",
    "strict": true,                        // เปิดใช้งานการตรวจสอบข้อผิดพลาดอย่างเข้มงวด
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noImplicitAny": true,
    "allowJs": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue"
  ],
  "exclude": [
    "node_modules"
  ]
}
